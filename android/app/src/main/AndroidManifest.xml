<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:hasCode="false"
        android:icon="${appIcon}"
        android:label="${appLabel}"
        android:supportsRtl="true">
        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:label="${appLabel}"
            android:screenOrientation="landscape">
            <!-- SFML 2 uses a tiny bootstrap library so it can load the C++
                 runtime, OpenAL, SFML modules, and finally our game library. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="${sfmlActivityLib}" />
            <meta-data
                android:name="sfml.app.lib_name"
                android:value="pac-android-empty-scene" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
