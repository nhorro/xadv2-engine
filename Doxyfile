# Doxygen is an implementation index for engine developers. MkDocs remains the
# narrative and authoring documentation. See docs/development/doxygen.md.

PROJECT_NAME           = "Extraordinary Adventures Engine v2"
PROJECT_NUMBER         = "0.9.0"
PROJECT_BRIEF          = "C++ engine implementation and API browser"
OUTPUT_DIRECTORY       = .doc/doxygen
CREATE_SUBDIRS         = NO

OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = README.md

INPUT                  = README.md \
                         lib/include/engine \
                         lib/src
FILE_PATTERNS          = *.hpp \
                         *.cpp
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */third_party/* \
                         */tests/* \
                         */build*/*
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = ./
STRIP_FROM_INC_PATH    = lib/include

# This is a code browser, not an API-completeness gate. Showing implementation
# details is intentional: the public headers alone do not explain RoomScene.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_DYNAMIC_MENUS     = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO

# The default browser has no Graphviz dependency. Set HAVE_DOT to YES locally
# for bounded include/inheritance graphs; call graphs remain disabled because
# RoomScene produces an unreadable hairball.
HAVE_DOT               = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DIRECTORY_GRAPH        = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = YES
DOT_GRAPH_MAX_NODES    = 60
MAX_DOT_GRAPH_DEPTH    = 3
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

QUIET                  = NO
