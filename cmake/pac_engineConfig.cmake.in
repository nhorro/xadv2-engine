@PACKAGE_INIT@

# Package config for the Extraordinary Adventures Engine v2.
#
#   find_package(pac_engine CONFIG REQUIRED)
#   target_link_libraries(mygame PRIVATE pac::engine)
#
# Targets provided:
#   pac::engine      the engine (SFML is PUBLIC, so it comes along)
#   pac::sol2        sol2 + Lua headers — link this ONLY if your game adds its own
#                    Lua functions / C++ scenes (engine/core/scripting_sol.hpp)
#   pac::lua         the Lua seam, on its own
#   pac::sanitizers  empty unless the engine was built with sanitizers, in which
#                    case it propagates the flags (mixing sanitized and unsanitized
#                    objects is unsafe, so this is not optional)

include(CMakeFindDependencyMacro)

# Re-run the engine's dependency discovery. This must happen BEFORE the targets
# file is loaded: the exported engine names imported targets (SFML's, yaml-cpp's
# and, on pkg-config platforms, PkgConfig::LUA) that only exist once this has run.
include("${CMAKE_CURRENT_LIST_DIR}/pacEngineDeps.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/pacEngineTargets.cmake")

check_required_components(pac_engine)
